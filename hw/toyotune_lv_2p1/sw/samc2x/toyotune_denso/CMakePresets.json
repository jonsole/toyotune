{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARM_TOOLCHAIN_DIR": ""
      }
    },
    {
      "name": "mr2-cpu1-debug",
      "displayName": "MR2 CPU1 (Debug)",
      "description": "D151803-9651, -O0 -g3",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOYOTUNE_CPU": "1",
        "TOYOTUNE_ECU": "MR2"
      }
    },
    {
      "name": "mr2-cpu1-release",
      "displayName": "MR2 CPU1 (Release)",
      "description": "D151803-9651, -Os",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TOYOTUNE_CPU": "1",
        "TOYOTUNE_ECU": "MR2"
      }
    },
    {
      "name": "mr2-cpu2-debug",
      "displayName": "MR2 CPU2 (Debug) - not yet implemented",
      "description": "Expected to fail: config.h #error until CPU2's image and DMA layout exist",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOYOTUNE_CPU": "2",
        "TOYOTUNE_ECU": "MR2"
      }
    },
    {
      "name": "st205-cpu1-debug",
      "displayName": "ST205 CPU1 (Debug) - not yet implemented",
      "description": "Expected to fail: config.h #error until the ST205 ROM image is added to image.c",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOYOTUNE_CPU": "1",
        "TOYOTUNE_ECU": "ST205"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mr2-cpu1-debug",
      "configurePreset": "mr2-cpu1-debug"
    },
    {
      "name": "mr2-cpu1-release",
      "configurePreset": "mr2-cpu1-release"
    },
    {
      "name": "mr2-cpu2-debug",
      "configurePreset": "mr2-cpu2-debug"
    },
    {
      "name": "st205-cpu1-debug",
      "configurePreset": "st205-cpu1-debug"
    }
  ]
}
