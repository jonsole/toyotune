{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]", "notIn": ["comment"] },
    { "open": "(", "close": ")", "notIn": ["comment"] },
    { "open": "\"", "close": "\"", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "\\.?[A-Za-z_][A-Za-z0-9_$]*|\\$[0-9A-Fa-f]+|[0-9][0-9A-Fa-f]*[hH]?"
}
