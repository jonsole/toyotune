# Build artifacts (see "Building a ROM" in CLAUDE.md)
output/

# Python
__pycache__/
*.pyc

# Editor config. Nested .vscode dirs stay ignored - they hold machine-specific
# paths from other machines. Only the repo-root shared config is tracked, so a
# workspace opened at the repo root can find the CMake project under hw/.
.vscode/
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json

# Profiler output
*.prof

# Stale superseded snapshots (see CLAUDE.md "- Copy files" note)
* - Copy.*
* - Copy

# Scratch dev-run leftovers from d8x_assembler development, not test fixtures
# or source
/roms/d8x_assembler/output
/roms/d8x_assembler/output.bin
/roms/d8x_assembler/output.lst
/roms/d8x_assembler/output.lst2
/roms/d8x_assembler/D151803-9651.ASM
/roms/d8x_assembler/D151803-9651.lst
/roms/d8x_assembler/D151804-0461_DIAG16_32K_JS.ASM
/roms/d8x_assembler/D151804-0461_DIAG16_32K_JS.BIN

# Atmel Studio / Visual Studio build output and per-user state (hw/*/sw/*)
Debug/
Release/
.vs/
*.atsuo
*.studiobackup

# Eagle CAD rolling backups (.brd/.sch/.lbr -> .b#N/.s#N/.l#N); the live files are kept
*.b#[0-9]
*.s#[0-9]
*.l#[0-9]

# Eagle CAM output: gerbers, drill files, and photoplotter/drill logs.
# Regenerate from the .cam jobs against the current .brd -- the .cam job files,
# .dru design rules and .gvp viewer projects are deliberately NOT ignored.
# NB: Excellon drill output is sometimes written as .txt; that pattern is
# intentionally omitted here because it would swallow roms/3S-GTE/roms.txt
# and output/build.txt. Rename such drill files to .drl instead.
*.G[0-9]L
*.GL[0-9]
*.GTL
*.GTO
*.GTS
*.GTP
*.GBL
*.GBO
*.GBS
*.GBP
*.GKO
*.GML
*.GM[0-9]
*.drd
*.drl
*.xln
*.exc
*.dri
*.gpi

# CMake/Ninja out-of-tree build output and the IntelliSense database it emits
build/
compile_commands.json
CMakeUserPresets.json

# Unzipped device packs (SAMC21 DFP, CMSIS) - ~108MB of third-party headers,
# freely re-downloadable from packs.download.microchip.com. See INSTALL.md.
/hw/toyotune_lv_2p1/sw/packs/
